{
	"name": "db-timetable-mcp",
	"version": "3.0.0",
	"description": "MCP server for structured Deutsche Bahn station timetable data",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js"
		},
		"./serverInfo": {
			"types": "./dist/serverInfo.d.ts",
			"import": "./dist/serverInfo.js"
		},
		"./api/timetableApi": {
			"types": "./dist/api/timetableApi.d.ts",
			"import": "./dist/api/timetableApi.js"
		},
		"./utils/errorHandling": {
			"types": "./dist/utils/errorHandling.d.ts",
			"import": "./dist/utils/errorHandling.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"db-timetable-mcp": "dist/index.js"
	},
	"files": [
		"dist",
		"docs",
		"README.md",
		"LICENSE.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist',{ recursive: true, force: true })\"",
		"build": "npm run clean && tsc",
		"start": "node dist/index.js",
		"dev": "tsx watch src/index.ts",
		"dev:http": "MCP_TRANSPORT=http tsx watch src/index.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "oxlint --quiet . && oxfmt --check .",
		"lint:fix": "oxlint --fix --quiet . && oxfmt .",
		"lint:changed": "node tools/oxlint/lint-changed.mjs",
		"knip": "knip --no-progress",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
		"stations:update": "tsx scripts/updateStations.ts",
		"check": "npm run lint && npm run typecheck && npm test && npm run build",
		"prepublishOnly": "npm run check",
		"prepare": "npm run build && node scripts/install-git-hooks.mjs"
	},
	"keywords": [
		"mcp",
		"deutsche-bahn",
		"timetable",
		"railway",
		"llm"
	],
	"author": "Nils Jorek <nils.jorek@gmx.de>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jorekai/db-timetable-mcp.git"
	},
	"bugs": {
		"url": "https://github.com/jorekai/db-timetable-mcp/issues"
	},
	"homepage": "https://github.com/jorekai/db-timetable-mcp#readme",
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@oxlint/plugins": "1.94.0",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.1",
		"fast-xml-parser": "^5.12.1",
		"knip": "^6.48.0",
		"lefthook": "^2.2.2",
		"oxfmt": "0.79.0",
		"oxlint": "1.94.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.1.1"
	}
}
