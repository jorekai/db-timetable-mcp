# API-Zugangsdaten für die Deutsche Bahn API
DB_TIMETABLE_CLIENT_ID=your-client-id
DB_TIMETABLE_CLIENT_SECRET=your-client-secret

# Server-Konfiguration: stdio für lokale MCP-Clients, http für Remote-Betrieb
MCP_TRANSPORT=stdio
HOST=127.0.0.1
PORT=3000
MCP_ENDPOINT=/mcp
# Bei HOST=0.0.0.0 verpflichtend; kommaseparierte Hostnamen ohne Port
# ALLOWED_HOSTS=localhost,127.0.0.1,mcp.example.com

# Optional: expliziter Pfad, falls .env nicht im Projektverzeichnis liegt
# DOTENV_CONFIG_PATH=/absolute/path/to/db-timetable.env
# DB_TIMETABLE_TIMEOUT_MS=15000

# Logging-Konfiguration
# Mögliche Werte: 'debug', 'info', 'warn', 'error'
LOG_LEVEL=info
